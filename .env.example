# ─── Real-time socket server (attached socketServer project) ─────────────
# Buyer/browser se seedha connect hone wala URL (client-side, is liye
# NEXT_PUBLIC_ prefix zaroori hai)
NEXT_PUBLIC_SOCKET_SERVER=https://your-socket-server.example.com

# Yehi socket server ke .env mein bhi honi chahiye (EXACTLY same value).
# Sirf server-side use hoti hai (emitSocketEvent.ts), is liye NEXT_PUBLIC_
# prefix NAHI lagana — warna browser mein leak ho jayegi.
SOCKET_INTERNAL_SECRET=change-this-to-a-long-random-secret

# ─── Baqi existing env vars (already project mein hongi) ──────────────────
# MONGODB_URI=...
# NEXTAUTH_SECRET=...
# NEXTAUTH_URL=...
# CLOUDINARY_...=...
# ...etc
